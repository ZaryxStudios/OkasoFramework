<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.zaryxstudios.okaso</groupId>
        <artifactId>okaso</artifactId>
        <version>1.8.2</version>
        <relativePath>../pom.xml</relativePath>
    </parent>
    <artifactId>okaso-signature</artifactId>
    <packaging>pom</packaging>
    <name>Okaso API Signature</name>
    <description>Animal Sniffer signature of the Java 8 and Spigot 1.8.8 APIs, the oldest platform Okaso supports.</description>
    <dependencies>
        <dependency>
            <groupId>org.spigotmc</groupId>
            <artifactId>spigot-api</artifactId>
            <version>${okaso.compat.spigot.version}</version>
        </dependency>
    </dependencies>
    <build>
        <plugins>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>animal-sniffer-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>check-oldest-bukkit-api</id>
                        <phase>none</phase>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
    <profiles>
        <profile>
            <id>build-signature</id>
            <activation>
                <property>
                    <name>!okaso.compat.skip</name>
                </property>
            </activation>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-enforcer-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>require-java8-home</id>
                                <goals><goal>enforce</goal></goals>
                                <configuration>
                                    <rules>
                                        <requireFilesExist>
                                            <files>
                                                <file>${okaso.compat.javaHome}/lib/rt.jar</file>
                                            </files>
                                            <message>The API compatibility signature needs Java 8 classes. Build with JDK 8, pass -Dokaso.compat.javaHome=/path/to/java8 (a JDK's jre folder or a JRE), or skip the check with -Dokaso.compat.skip=true.</message>
                                        </requireFilesExist>
                                    </rules>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>animal-sniffer-maven-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>build-signature</id>
                                <phase>package</phase>
                                <goals><goal>build</goal></goals>
                                <configuration>
                                    <javaHome>${okaso.compat.javaHome}</javaHome>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
